# Copy this file to .env and fill in any local-only credentials.
HTTP_PORT=8080
POSTGRES_DSN=postgres://shrinkr:shrinkr@localhost:5433/shrinkr?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
BASE_SHORT_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHORT_CODE_BYTES=6

# AWS / SQS
AWS_REGION=us-east-2
SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/

# Prefer `aws configure` or AWS SSO. Uncomment only for local development.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Worker tuning
SQS_BATCH_SIZE=10
SQS_WAIT_TIME_SECONDS=20
